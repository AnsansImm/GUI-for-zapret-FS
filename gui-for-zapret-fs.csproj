<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gui-for-zapret-fs</AssemblyName>
    <RootNamespace>ZapretGui</RootNamespace>
    <Product>gui-for-zapret-fs</Product>
    <Title>gui-for-zapret-fs</Title>
    <Description>Portable Windows GUI for Flowseal Zapret</Description>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="assets/app.ico" LogicalName="gui-for-zapret-fs.app.ico" />
    <Content Include="scripts/test-runner.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="scripts/update-zapret.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="scripts/diagnostics.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="scripts/service-control.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
